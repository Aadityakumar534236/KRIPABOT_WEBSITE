PORT=3001
FRONTEND_ORIGIN=
VITE_API_BASE_URL=

# Use long random values in production. Do not commit real secrets.
JWT_SECRET=replace-with-a-long-random-secret-at-least-24-characters
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-running
# Preferred for production. Generate with bcrypt and omit ADMIN_PASSWORD when set.
ADMIN_PASSWORD_HASH=

AI_PROVIDER=none
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

STORAGE_PROVIDER=local
MAX_UPLOAD_MB=20
DATA_DIR=server/data
UPLOAD_DIR=server/uploads

# Set STORAGE_PROVIDER=apps-script to use private Drive storage through Apps Script.
# Apps Script cannot stream large files; keep these bridge limits conservative.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
APPS_SCRIPT_MAX_BRIDGE_MB=4
APPS_SCRIPT_MAX_VIDEO_MB=2
