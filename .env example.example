PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-before-running
AI_PROVIDER=none
AI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
STORAGE_PROVIDER=local
# Set STORAGE_PROVIDER=apps-script to use private Drive storage through Apps Script.
# No Google Cloud service account or Google Cloud billing is required.
GOOGLE_APPS_SCRIPT_URL=
GOOGLE_APPS_SCRIPT_SECRET=
# Conservative Base64 bridge limits for Apps Script. Local storage still uses MAX_UPLOAD_MB.
APPS_SCRIPT_MAX_BRIDGE_MB=4
APPS_SCRIPT_MAX_VIDEO_MB=2
MAX_UPLOAD_MB=20
